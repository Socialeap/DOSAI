{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:guest-artifact-manifest:2",
  "title": "DOSAI Unverified Guest Composition Candidate Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "manifest_id", "artifact_set_version", "architecture", "boot_protocol", "release_status", "runtime_eligible", "artifacts", "supply_chain", "composition"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:guest-artifact-manifest:2" },
    "schema_version": { "const": 2 },
    "manifest_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "artifact_set_version": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "architecture": { "const": "arm64" },
    "boot_protocol": { "const": "LINUX_DIRECT_BOOT" },
    "release_status": { "const": "COMPOSITION_DECLARED_UNVERIFIED" },
    "runtime_eligible": { "const": false },
    "artifacts": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "package_path", "sha256", "size_bytes", "media_type", "read_only"],
        "properties": {
          "role": { "enum": ["KERNEL", "INITRAMFS", "ROOT_FILESYSTEM", "GUEST_AGENT"] },
          "package_path": { "type": "string", "pattern": "^guest-artifacts/v2/[a-z0-9][a-z0-9._-]{0,127}$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "size_bytes": { "type": "integer", "minimum": 1, "maximum": 4294967296 },
          "media_type": { "enum": ["application/vnd.linux.kernel", "application/vnd.linux.initramfs", "application/vnd.dosai.squashfs", "application/vnd.dosai.guest-agent"] },
          "read_only": { "const": true }
        }
      }
    },
    "supply_chain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["build_recipe_sha256", "source_manifest_sha256", "sbom_sha256", "sbom_format", "license_manifest_sha256", "clean_room_rebuild", "vulnerability_review", "signatures_verified"],
      "properties": {
        "build_recipe_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sbom_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "sbom_format": { "const": "SPDX_2_3_JSON" },
        "license_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "clean_room_rebuild": { "const": "NOT_PROVEN" },
        "vulnerability_review": { "const": "NOT_PERFORMED" },
        "signatures_verified": { "const": false }
      }
    },
    "composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verification_status", "kernel_command_line", "kernel_config", "filesystem_inventories", "boot_chain", "embedded_guest_agent", "verification"],
      "properties": {
        "verification_status": { "const": "NOT_PERFORMED" },
        "kernel_command_line": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_path", "sha256", "size_bytes", "media_type"],
          "properties": {
            "package_path": { "type": "string", "pattern": "^guest-artifacts/v2/[a-z0-9][a-z0-9._-]{0,127}$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 1, "maximum": 4096 },
            "media_type": { "const": "text/plain; charset=us-ascii" }
          }
        },
        "kernel_config": {
          "type": "object",
          "additionalProperties": false,
          "required": ["package_path", "sha256", "size_bytes", "media_type", "loadable_modules", "module_loading", "debug_interfaces", "network_stack", "interactive_console"],
          "properties": {
            "package_path": { "type": "string", "pattern": "^guest-artifacts/v2/[a-z0-9][a-z0-9._-]{0,127}$" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
            "size_bytes": { "type": "integer", "minimum": 1, "maximum": 1048576 },
            "media_type": { "const": "text/plain; charset=us-ascii" },
            "loadable_modules": { "const": false },
            "module_loading": { "const": false },
            "debug_interfaces": { "const": false },
            "network_stack": { "const": false },
            "interactive_console": { "const": false }
          }
        },
        "filesystem_inventories": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["filesystem_role", "package_path", "sha256", "size_bytes", "media_type", "format", "entry_count"],
            "properties": {
              "filesystem_role": { "enum": ["INITRAMFS", "ROOT_FILESYSTEM"] },
              "package_path": { "type": "string", "pattern": "^guest-artifacts/v2/[a-z0-9][a-z0-9._-]{0,127}$" },
              "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
              "size_bytes": { "type": "integer", "minimum": 2, "maximum": 16777216 },
              "media_type": { "const": "application/vnd.dosai.fs-inventory+json" },
              "format": { "const": "DOSAI_FS_INVENTORY_V1" },
              "entry_count": { "type": "integer", "minimum": 1, "maximum": 65536 }
            }
          }
        },
        "boot_chain": {
          "type": "object",
          "additionalProperties": false,
          "required": ["initramfs_entry_path", "immutable_root_device", "immutable_root_filesystem", "immutable_root_read_only", "guest_agent_path", "alternate_init_allowed", "rescue_shell_allowed", "login_allowed"],
          "properties": {
            "initramfs_entry_path": { "const": "/init" },
            "immutable_root_device": { "const": "/dev/vda" },
            "immutable_root_filesystem": { "const": "squashfs" },
            "immutable_root_read_only": { "const": true },
            "guest_agent_path": { "const": "/sbin/dosai-guest-agent" },
            "alternate_init_allowed": { "const": false },
            "rescue_shell_allowed": { "const": false },
            "login_allowed": { "const": false }
          }
        },
        "embedded_guest_agent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["filesystem_role", "path", "sha256"],
          "properties": {
            "filesystem_role": { "const": "ROOT_FILESYSTEM" },
            "path": { "const": "/sbin/dosai-guest-agent" },
            "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
          }
        },
        "verification": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kernel_command_line_reviewed", "kernel_config_reviewed", "inventories_verified", "embedded_agent_digest_matched", "boot_chain_verified"],
          "properties": {
            "kernel_command_line_reviewed": { "const": false },
            "kernel_config_reviewed": { "const": false },
            "inventories_verified": { "const": false },
            "embedded_agent_digest_matched": { "const": false },
            "boot_chain_verified": { "const": false }
          }
        }
      }
    }
  }
}

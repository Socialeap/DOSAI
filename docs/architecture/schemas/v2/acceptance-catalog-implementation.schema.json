{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:acceptance-catalog-implementation:2",
  "title": "DOSAI Acceptance Catalog Implementation Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "manifest_id", "created_at", "data_class", "status", "predecessor", "successor", "runner", "schemas", "fixtures", "implementations", "limitations", "invariants"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:acceptance-catalog-implementation:2" },
    "schema_version": { "const": 2 },
    "manifest_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "data_class": { "const": "D5" },
    "status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED"] },
    "predecessor": { "$ref": "#/$defs/catalog_reference" },
    "successor": { "$ref": "#/$defs/catalog_reference" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "package_path", "package_digest", "executable_digest", "dependency_lock_digest", "workspace_config_digest", "workspace_specifier", "shell"],
      "properties": {
        "id": { "const": "dosai-acceptance" },
        "version": { "const": "0.2.0" },
        "package_path": { "const": "tools/dosai-acceptance/package.json" },
        "package_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "executable_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "dependency_lock_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "workspace_config_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "workspace_specifier": { "const": "workspace:0.2.0" },
        "shell": { "const": false }
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/schema_reference" }
    },
    "fixtures": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "items": { "$ref": "#/$defs/fixture" }
    },
    "implementations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/implementation" }
    },
    "limitations": {
      "const": ["SECURE_ENCLAVE_RUNTIME_PROOF_DEFERRED_EXTERNAL", "REKOR_V2_PUBLICATION_PROOF_DEFERRED_EXTERNAL"]
    },
    "invariants": {
      "const": ["ONLY_P2_SUITES_NEWLY_IMPLEMENTED", "P1_ASSERTION_SCOPE_UNCHANGED", "SCENARIO_SCOPE_UNCHANGED", "FIXTURES_DIGEST_BOUND", "FAIL_CLOSED_RUNNER", "ARTIFACT_CLASSES_COMPLETE", "NO_EXTERNAL_EFFECT", "EXTERNAL_ASSURANCE_NOT_CLAIMED"]
    }
  },
  "$defs": {
    "catalog_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/testing/acceptance-test-catalog-v[45]\\.json$" },
        "version": { "type": "integer", "minimum": 4, "maximum": 5 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "sha256"],
      "properties": {
        "schema_id": { "type": "string", "pattern": "^urn:dosai:schema:[a-z-]+:[1-5]$" },
        "path": { "type": "string", "pattern": "^docs/architecture/schemas/v[1-5]/[a-z-]+\\.schema\\.json$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "path", "role", "status", "sha256"],
      "properties": {
        "suite_id": { "type": "string", "pattern": "^P[12]-AT-00[1-3]$" },
        "path": { "type": "string", "pattern": "^tests/acceptance/manifests/p[12]-at-00[1-3]-v3\\.json$" },
        "role": { "type": "string", "enum": ["IDENTITY_MIGRATION", "NEW_IMPLEMENTATION"] },
        "status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "previous_state", "current_state", "fixture_manifest", "fixture_status", "fixture_digest"],
      "properties": {
        "suite_id": { "type": "string", "pattern": "^P2-AT-00[1-3]$" },
        "previous_state": { "const": "NOT_IMPLEMENTED" },
        "current_state": { "const": "IMPLEMENTED" },
        "fixture_manifest": { "type": "string", "pattern": "^tests/acceptance/manifests/p2-at-00[1-3]-v3\\.json$" },
        "fixture_status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED"] },
        "fixture_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" }
      }
    }
  }
}

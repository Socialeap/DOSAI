{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:audit-event:2",
  "title": "DOSAI Canonical Audit Event v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "message_id", "created_at", "producer", "producer_generation", "trace_id", "data_class", "algorithm_suite", "journal_id", "journal_epoch_id", "boot_id", "writer_epoch_id", "sequence", "source", "observed_at", "wall_clock_uncertainty_ms", "monotonic_ms", "previous_event_hash", "request_message_id", "request_digest", "acknowledgement_message_id", "event_kind", "payload"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:audit-event:2" },
    "schema_version": { "const": 2 },
    "message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "const": "dosai.audit-writer" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "trace_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "data_class": { "const": "D1" },
    "algorithm_suite": { "const": "DOSAI-JOURNAL-SHA256-JCS-V1" },
    "journal_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "journal_epoch_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "boot_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "writer_epoch_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "sequence": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "source_generation", "provenance"],
      "properties": {
        "source_id": { "const": "dosai.capsule-registry" },
        "source_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
        "provenance": { "const": "SUPERVISOR_OBSERVATION" }
      }
    },
    "observed_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "wall_clock_uncertainty_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "monotonic_ms": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "previous_event_hash": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
    "request_message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "request_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
    "acknowledgement_message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "event_kind": { "type": "string", "enum": ["CAPSULE_REGISTRY_REVISION_COMMITTED", "CAPSULE_REGISTRY_RECOVERY_GAP"] },
    "payload": { "type": "object" }
  },
  "allOf": [
    {
      "if": { "properties": { "event_kind": { "const": "CAPSULE_REGISTRY_REVISION_COMMITTED" } }, "required": ["event_kind"] },
      "then": { "properties": { "payload": { "$ref": "urn:dosai:schema:audit-event-proposal:2#/$defs/revision_committed" } } }
    },
    {
      "if": { "properties": { "event_kind": { "const": "CAPSULE_REGISTRY_RECOVERY_GAP" } }, "required": ["event_kind"] },
      "then": { "properties": { "payload": { "$ref": "urn:dosai:schema:audit-event-proposal:2#/$defs/recovery_gap" } } }
    }
  ]
}

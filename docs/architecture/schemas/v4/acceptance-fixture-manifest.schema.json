{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:acceptance-fixture-manifest:4",
  "title": "DOSAI P3 Acceptance Fixture Manifest v4 Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "manifest_id", "created_at", "data_class", "catalog_version", "suite_id", "fixture_version", "status", "runner", "secret_canary_set_version", "platform_profiles", "required_artifacts", "cases"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:acceptance-fixture-manifest:4" },
    "schema_version": { "const": 4 },
    "manifest_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "data_class": { "const": "D5" },
    "catalog_version": { "const": 5 },
    "suite_id": { "type": "string", "pattern": "^P3-AT-00[1-3]$" },
    "fixture_version": { "const": 4 },
    "status": { "const": "PROPOSED" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "const": "dosai-acceptance" },
        "version": { "const": "0.3.0" }
      }
    },
    "secret_canary_set_version": { "const": 1 },
    "platform_profiles": { "const": ["MACOS_ARM64_V1", "LINUX_AMD64_V1"] },
    "required_artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact_class" }
    },
    "cases": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "safe_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "artifact_class": { "type": "string", "enum": ["REPORT", "ASSERTIONS", "ENVIRONMENT", "COMMAND", "MANIFEST", "JOURNAL", "PACKAGE", "PERFORMANCE", "VERIFIER", "CLEANUP"] },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "scenario_id", "mode", "handler_id", "input_profile", "input_digest", "input_data_class", "preconditions", "setup_operations", "action_deadline_ms", "assertions", "expected_external_effect", "cancellation_postcondition", "teardown_postconditions", "retention_profile", "deletion_postcondition", "eligible_claims", "limitations"],
      "properties": {
        "id": { "type": "string", "pattern": "^P3-AT-00[1-3]-S0[12]-C01$" },
        "scenario_id": { "type": "string", "pattern": "^P3-AT-00[1-3]-S0[12]$" },
        "mode": { "type": "string", "enum": ["POSITIVE", "SECURITY", "FAULT", "RECOVERY", "LOAD"] },
        "handler_id": { "type": "string", "enum": ["P3_TYPED_EXECUTION_CAPSULE", "P3_EXECUTION_ATTACK_CORPUS", "P3_CANCELLATION_FAULT_MATRIX", "P3_SCOPED_CLEANUP_SECURITY", "P3_WATCHDOG_SATURATION_MATRIX", "P3_CRASH_RECONCILIATION_MATRIX"] },
        "input_profile": { "$ref": "#/$defs/safe_code" },
        "input_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "input_data_class": { "const": "D5" },
        "preconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safe_code" } },
        "setup_operations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safe_code" } },
        "action_deadline_ms": { "type": "integer", "minimum": 1000, "maximum": 1800000 },
        "assertions": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assertion" } },
        "expected_external_effect": { "const": "NONE" },
        "cancellation_postcondition": { "$ref": "#/$defs/safe_code" },
        "teardown_postconditions": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safe_code" } },
        "retention_profile": { "const": "R3_EVIDENCE_STANDARD" },
        "deletion_postcondition": { "$ref": "#/$defs/safe_code" },
        "eligible_claims": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{1,31}$" } },
        "limitations": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/safe_code" } }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "expected_code", "artifact_classes"],
      "properties": {
        "id": { "$ref": "#/$defs/safe_code" },
        "expected_code": { "const": "ASSERTION_PASS" },
        "artifact_classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/artifact_class" } }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:resource-precondition:1",
  "title": "DOSAI Resource Precondition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "message_id", "created_at", "producer", "producer_generation", "trace_id", "data_class", "precondition_id", "resource_id", "resource_kind", "condition"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:resource-precondition:1" },
    "schema_version": { "const": 1 },
    "message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "trace_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "data_class": { "const": "D5" },
    "precondition_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "resource_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "resource_kind": { "const": "SYNTHETIC_RESOURCE" },
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expected_generation"],
          "properties": {
            "kind": { "const": "GENERATION_MATCH" },
            "expected_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expected_digest"],
          "properties": {
            "kind": { "const": "DIGEST_MATCH" },
            "expected_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "expected_state"],
          "properties": {
            "kind": { "const": "AVAILABILITY_MATCH" },
            "expected_state": { "type": "string", "enum": ["AVAILABLE", "UNAVAILABLE"] }
          }
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:operation:1",
  "title": "DOSAI Synthetic Policy-Probe Operation v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "message_id", "created_at", "producer", "producer_generation", "trace_id", "data_class", "operation_id", "operation_kind", "actor", "target", "requested_capabilities", "effect_profile", "expected_effects", "limits"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:operation:1" },
    "schema_version": { "const": 1 },
    "message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "trace_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "data_class": { "const": "D5" },
    "operation_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "operation_kind": { "const": "SYNTHETIC_POLICY_PROBE" },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_id", "actor_generation", "session_id"],
      "properties": {
        "actor_id": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
        "actor_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
        "session_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "resource_kind", "environment", "generation"],
      "properties": {
        "resource_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
        "resource_kind": { "const": "SYNTHETIC_RESOURCE" },
        "environment": { "type": "string", "enum": ["LOCAL_TEST", "LOCAL_DEVELOPMENT", "STAGING", "PRODUCTION"] },
        "generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" }
      }
    },
    "requested_capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:dosai:schema:common:1#/$defs/capability_id" }
    },
    "effect_profile": { "type": "string", "enum": ["NONE", "READ_LOCAL", "MUTATE_LOCAL", "MUTATE_REMOTE", "PROHIBITED"] },
    "expected_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["NONE", "LOCAL_READ", "LOCAL_MUTATION", "REMOTE_MUTATION", "UNKNOWN"] }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deadline_ms", "max_output_bytes"],
      "properties": {
        "deadline_ms": { "type": "integer", "minimum": 1, "maximum": 10000 },
        "max_output_bytes": { "type": "integer", "minimum": 0, "maximum": 1048576 }
      }
    }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "effect_profile": { "const": "NONE" } }, "required": ["effect_profile"] },
      "then": { "type": "object", "properties": { "expected_effects": { "const": ["NONE"] } } }
    },
    {
      "if": { "type": "object", "properties": { "effect_profile": { "const": "READ_LOCAL" } }, "required": ["effect_profile"] },
      "then": { "type": "object", "properties": { "expected_effects": { "const": ["LOCAL_READ"] } } }
    },
    {
      "if": { "type": "object", "properties": { "effect_profile": { "const": "MUTATE_LOCAL" } }, "required": ["effect_profile"] },
      "then": { "type": "object", "properties": { "expected_effects": { "const": ["LOCAL_MUTATION"] } } }
    },
    {
      "if": { "type": "object", "properties": { "effect_profile": { "const": "MUTATE_REMOTE" } }, "required": ["effect_profile"] },
      "then": { "type": "object", "properties": { "expected_effects": { "const": ["REMOTE_MUTATION"] } } }
    },
    {
      "if": { "type": "object", "properties": { "effect_profile": { "const": "PROHIBITED" } }, "required": ["effect_profile"] },
      "then": { "type": "object", "properties": { "expected_effects": { "const": ["UNKNOWN"] } } }
    }
  ]
}

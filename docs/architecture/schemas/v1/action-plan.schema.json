{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:action-plan:1",
  "title": "DOSAI Immutable Action Plan v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "message_id", "created_at", "producer", "producer_generation", "trace_id", "data_class", "plan_id", "operation_id", "operation_digest", "actor_id", "session_id", "target", "resource_preconditions", "policy_version", "minimum_tier", "effective_capabilities", "approval_requirement", "predicted_effects", "evidence_requirements", "expires_at"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:action-plan:1" },
    "schema_version": { "const": 1 },
    "message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "trace_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "data_class": { "const": "D5" },
    "plan_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "operation_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "operation_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
    "actor_id": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "session_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_id", "resource_kind", "environment", "generation"],
      "properties": {
        "resource_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
        "resource_kind": { "const": "SYNTHETIC_RESOURCE" },
        "environment": { "type": "string", "enum": ["LOCAL_TEST", "LOCAL_DEVELOPMENT", "STAGING", "PRODUCTION"] },
        "generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" }
      }
    },
    "resource_preconditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["precondition_id", "precondition_digest"],
        "properties": {
          "precondition_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
          "precondition_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" }
        }
      }
    },
    "policy_version": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "minimum_tier": { "type": "string", "enum": ["GREEN", "YELLOW", "RED", "BLACK"] },
    "effective_capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:dosai:schema:common:1#/$defs/capability_id" }
    },
    "approval_requirement": { "type": "string", "enum": ["NONE", "CAPABILITY_ENVELOPE", "FRESH_LOCAL", "PROHIBITED"] },
    "predicted_effects": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "type": "string", "enum": ["NONE", "LOCAL_READ", "LOCAL_MUTATION", "REMOTE_MUTATION", "UNKNOWN"] }
    },
    "evidence_requirements": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
    },
    "credential_scope_id": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "expires_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "minimum_tier": { "const": "GREEN" } }, "required": ["minimum_tier"] },
      "then": { "type": "object", "properties": { "approval_requirement": { "const": "NONE" } } }
    },
    {
      "if": { "type": "object", "properties": { "minimum_tier": { "const": "YELLOW" } }, "required": ["minimum_tier"] },
      "then": { "type": "object", "properties": { "approval_requirement": { "const": "CAPABILITY_ENVELOPE" } } }
    },
    {
      "if": { "type": "object", "properties": { "minimum_tier": { "const": "RED" } }, "required": ["minimum_tier"] },
      "then": { "type": "object", "properties": { "approval_requirement": { "const": "FRESH_LOCAL" } } }
    },
    {
      "if": { "type": "object", "properties": { "minimum_tier": { "const": "BLACK" } }, "required": ["minimum_tier"] },
      "then": { "type": "object", "properties": { "approval_requirement": { "const": "PROHIBITED" }, "effective_capabilities": { "type": "array", "maxItems": 0 } } }
    }
  ]
}

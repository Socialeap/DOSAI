{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:policy-decision:1",
  "title": "DOSAI Policy Decision v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "message_id", "created_at", "producer", "producer_generation", "trace_id", "data_class", "decision_id", "plan_id", "plan_digest", "policy_version", "minimum_tier", "enforced_tier", "result", "reason_codes", "effective_capabilities", "approval_requirement", "grant_eligible"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:policy-decision:1" },
    "schema_version": { "const": 1 },
    "message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "const": "dosai.policy" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "trace_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "data_class": { "const": "D5" },
    "decision_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "plan_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "plan_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
    "policy_version": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "minimum_tier": { "type": "string", "enum": ["GREEN", "YELLOW", "RED", "BLACK"] },
    "enforced_tier": { "type": "string", "enum": ["GREEN", "YELLOW", "RED", "BLACK"] },
    "result": { "type": "string", "enum": ["ALLOW", "DENY"] },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" }
    },
    "effective_capabilities": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "urn:dosai:schema:common:1#/$defs/capability_id" }
    },
    "approval_requirement": { "type": "string", "enum": ["NONE", "CAPABILITY_ENVELOPE", "FRESH_LOCAL", "PROHIBITED"] },
    "grant_eligible": { "type": "boolean" }
  },
  "allOf": [
    {
      "if": { "type": "object", "properties": { "result": { "const": "DENY" } }, "required": ["result"] },
      "then": { "type": "object", "properties": { "effective_capabilities": { "type": "array", "maxItems": 0 }, "grant_eligible": { "const": false } } }
    },
    {
      "if": { "type": "object", "properties": { "enforced_tier": { "const": "BLACK" } }, "required": ["enforced_tier"] },
      "then": { "type": "object", "properties": { "result": { "const": "DENY" }, "approval_requirement": { "const": "PROHIBITED" }, "grant_eligible": { "const": false } } }
    },
    {
      "if": { "type": "object", "properties": { "enforced_tier": { "const": "GREEN" } }, "required": ["enforced_tier"] },
      "then": { "type": "object", "properties": { "approval_requirement": { "const": "NONE" } } }
    },
    {
      "if": { "type": "object", "properties": { "enforced_tier": { "const": "YELLOW" } }, "required": ["enforced_tier"] },
      "then": { "type": "object", "properties": { "approval_requirement": { "const": "CAPABILITY_ENVELOPE" } } }
    },
    {
      "if": { "type": "object", "properties": { "enforced_tier": { "const": "RED" } }, "required": ["enforced_tier"] },
      "then": { "type": "object", "properties": { "approval_requirement": { "const": "FRESH_LOCAL" } } }
    }
  ],
  "anyOf": [
    { "type": "object", "properties": { "minimum_tier": { "const": "GREEN" }, "enforced_tier": { "enum": ["GREEN", "YELLOW", "RED", "BLACK"] } }, "required": ["minimum_tier", "enforced_tier"] },
    { "type": "object", "properties": { "minimum_tier": { "const": "YELLOW" }, "enforced_tier": { "enum": ["YELLOW", "RED", "BLACK"] } }, "required": ["minimum_tier", "enforced_tier"] },
    { "type": "object", "properties": { "minimum_tier": { "const": "RED" }, "enforced_tier": { "enum": ["RED", "BLACK"] } }, "required": ["minimum_tier", "enforced_tier"] },
    { "type": "object", "properties": { "minimum_tier": { "const": "BLACK" }, "enforced_tier": { "const": "BLACK" } }, "required": ["minimum_tier", "enforced_tier"] }
  ]
}

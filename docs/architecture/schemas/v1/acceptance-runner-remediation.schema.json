{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:acceptance-runner-remediation:1",
  "title": "DOSAI Acceptance Runner Remediation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "manifest_id", "created_at", "data_class", "status", "failed_attempt", "predecessor", "successor", "runner", "fixtures", "schemas", "changes", "invariants"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:acceptance-runner-remediation:1" },
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "data_class": { "const": "D5" },
    "status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED"] },
    "failed_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_id", "run_id", "report_digest", "subject_commit", "suite_id", "result", "failure_stage", "failure_code", "root_cause", "cleanup_result", "secret_scan_result"],
      "properties": {
        "report_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
        "run_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
        "report_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "subject_commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "suite_id": { "const": "P1-AT-001" },
        "result": { "const": "FAIL" },
        "failure_stage": { "const": "BOUNDARY_PROBES" },
        "failure_code": { "const": "RUNTIME_EVALUATION_FAILED" },
        "root_cause": { "const": "DOCUMENT_READINESS_RACE" },
        "cleanup_result": { "const": "PASS" },
        "secret_scan_result": { "const": "PASS" }
      }
    },
    "predecessor": { "$ref": "#/$defs/catalog_reference" },
    "successor": { "$ref": "#/$defs/catalog_reference" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "from_version", "to_version", "from_executable_digest", "to_executable_digest", "package_digest", "dependency_lock_digest", "workspace_config_digest", "shell"],
      "properties": {
        "id": { "const": "dosai-acceptance" },
        "from_version": { "const": "0.1.0" },
        "to_version": { "const": "0.1.1" },
        "from_executable_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "to_executable_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "package_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "dependency_lock_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "workspace_config_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "shell": { "const": false }
      }
    },
    "fixtures": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/fixture_reference" }
    },
    "schemas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/schema_reference" }
    },
    "changes": {
      "const": ["WAIT_FOR_HEALTHY_PAGE_BEFORE_BOUNDARY_PROBES", "SAFE_FAILURE_CODE_ONLY", "RUNNER_VERSION_ADVANCED", "NO_TEST_ASSERTION_REMOVED"]
    },
    "invariants": {
      "const": ["FAILED_ATTEMPT_PRESERVED", "SUITE_SCOPE_UNCHANGED", "ONLY_FIXTURE_IDENTITY_CHANGED", "NO_APPLICATION_AUTHORITY_CHANGE", "NO_EXTERNAL_EFFECT"]
    }
  },
  "$defs": {
    "catalog_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/testing/acceptance-test-catalog-v[34]\\.json$" },
        "version": { "type": "integer", "minimum": 3, "maximum": 4 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "fixture_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "path", "status", "sha256"],
      "properties": {
        "suite_id": { "type": "string", "pattern": "^P1-AT-00[1-3]$" },
        "path": { "type": "string", "pattern": "^tests/acceptance/manifests/p1-at-00[1-3]-v2\\.json$" },
        "status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED"] },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "sha256"],
      "properties": {
        "schema_id": { "type": "string", "pattern": "^urn:dosai:schema:[a-z-]+:[124]$" },
        "path": { "type": "string", "pattern": "^docs/architecture/schemas/v[124]/[a-z-]+\\.schema\\.json$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    }
  }
}

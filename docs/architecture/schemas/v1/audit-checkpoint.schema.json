{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:audit-checkpoint:1",
  "title": "DOSAI Signed Audit Checkpoint v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "checkpoint_id", "created_at", "producer", "producer_generation", "data_class", "journal_algorithm_suite", "checkpoint_algorithm_suite", "checkpoint_policy_version", "journal_id", "journal_epoch_id", "sequence", "event_hash", "previous_checkpoint_digest", "previous_anchor_receipt_digest", "transition", "active_signing_key_id", "signing_keys", "signatures"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:audit-checkpoint:1" },
    "schema_version": { "const": 1 },
    "checkpoint_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "const": "dosai.checkpoint-signer" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "data_class": { "const": "D5" },
    "journal_algorithm_suite": { "const": "DOSAI-JOURNAL-SHA256-JCS-V1" },
    "checkpoint_algorithm_suite": { "const": "DOSAI-CHECKPOINT-ECDSA-P256-SHA256-JCS-V1" },
    "checkpoint_policy_version": { "const": "1" },
    "journal_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "journal_epoch_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "sequence": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "event_hash": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
    "previous_checkpoint_digest": { "$ref": "#/$defs/nullable_digest" },
    "previous_anchor_receipt_digest": { "$ref": "#/$defs/nullable_digest" },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "previous_signing_key_id", "reason_code"],
      "properties": {
        "kind": { "type": "string", "enum": ["GENESIS", "CONTINUITY", "ROTATION", "RECOVERY"] },
        "previous_signing_key_id": { "oneOf": [{ "$ref": "#/$defs/key_id" }, { "type": "null" }] },
        "reason_code": { "type": "string", "enum": ["INITIAL_INSTALL", "PERIODIC", "EFFECT_CRITICAL", "OWNER_ROTATION", "KEY_LOSS", "HARDWARE_MIGRATION", "PLATFORM_UNAVAILABLE"] }
      }
    },
    "active_signing_key_id": { "$ref": "#/$defs/key_id" },
    "signing_keys": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/signing_key" }
    },
    "signatures": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "$ref": "#/$defs/signature" }
    }
  },
  "$defs": {
    "key_id": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "nullable_digest": { "oneOf": [{ "$ref": "urn:dosai:schema:common:1#/$defs/digest" }, { "type": "null" }] },
    "signing_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "algorithm", "protection", "public_key_spki_der_base64"],
      "properties": {
        "key_id": { "$ref": "#/$defs/key_id" },
        "algorithm": { "const": "ECDSA_P256_SHA256" },
        "protection": { "type": "string", "enum": ["SECURE_ENCLAVE", "SOFTWARE_BACKED_TEST_ONLY"] },
        "public_key_spki_der_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 256 }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key_id", "format", "value_base64"],
      "properties": {
        "key_id": { "$ref": "#/$defs/key_id" },
        "format": { "const": "ASN1_DER" },
        "value_base64": { "type": "string", "pattern": "^[A-Za-z0-9+/]+={0,2}$", "maxLength": 144 }
      }
    }
  }
}

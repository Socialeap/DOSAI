{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:capability-record:1",
  "title": "DOSAI Capability Record v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "support_state": {
            "enum": ["SUPPORTED", "SUPPORTED_WITH_CONSTRAINTS", "UNSUPPORTED"]
          }
        },
        "required": ["support_state"]
      },
      "then": {
        "properties": {
          "evidence_state": { "const": "CURRENT" },
          "evidence_refs": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "support_state": { "const": "SUPPORTED_WITH_CONSTRAINTS" }
        },
        "required": ["support_state"]
      },
      "then": {
        "properties": {
          "constraints": { "minItems": 1 }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_state": { "enum": ["STALE", "INVALIDATED"] }
        },
        "required": ["evidence_state"]
      },
      "then": {
        "properties": {
          "support_state": { "const": "UNVERIFIED" }
        }
      }
    },
    {
      "if": {
        "properties": {
          "evidence_state": { "const": "ABSENT" }
        },
        "required": ["evidence_state"]
      },
      "then": {
        "properties": {
          "support_state": { "const": "UNVERIFIED" },
          "evidence_refs": { "maxItems": 0 }
        }
      }
    }
  ],
  "required": [
    "schema_id",
    "schema_version",
    "message_id",
    "created_at",
    "producer",
    "producer_generation",
    "trace_id",
    "data_class",
    "capability_id",
    "actor_id",
    "platform_profile",
    "support_state",
    "evidence_state",
    "availability",
    "constraints",
    "evidence_refs",
    "fallback"
  ],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:capability-record:1" },
    "schema_version": { "const": 1 },
    "message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "trace_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "data_class": { "const": "D5" },
    "capability_id": { "$ref": "urn:dosai:schema:common:1#/$defs/capability_id" },
    "actor_id": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "platform_profile": { "const": "MACOS_ARM64_V1" },
    "support_state": {
      "type": "string",
      "enum": ["UNVERIFIED", "SUPPORTED", "SUPPORTED_WITH_CONSTRAINTS", "UNSUPPORTED"]
    },
    "evidence_state": {
      "type": "string",
      "enum": ["ABSENT", "CURRENT", "STALE", "INVALIDATED"]
    },
    "availability": {
      "type": "string",
      "enum": ["UNKNOWN", "AVAILABLE", "DEGRADED", "BLOCKED", "UNAVAILABLE"]
    },
    "constraints": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$",
        "maxLength": 128
      }
    },
    "evidence_refs": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" }
    },
    "fallback": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^[ -~]+$"
    },
    "valid_through": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "invalidated_by": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" }
  }
}

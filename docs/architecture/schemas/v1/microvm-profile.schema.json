{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:microvm-profile:1",
  "title": "DOSAI Non-Runnable Structural MicroVM Profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "profile_id", "capsule_id", "generation", "guest_manifest_sha256", "validation_level", "runtime_eligible", "cpu_count", "memory_size_bytes", "immutable_root_filesystem", "writable_disk_size_bytes", "writable_state_reuse", "network_devices", "shares", "guest_identity", "integrations", "lifecycle"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:microvm-profile:1" },
    "schema_version": { "const": 1 },
    "profile_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "capsule_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "guest_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "validation_level": { "const": "STRUCTURAL_ONLY_NO_BOOT_ARTIFACTS" },
    "runtime_eligible": { "const": false },
    "cpu_count": { "const": 1 },
    "memory_size_bytes": { "const": 536870912 },
    "immutable_root_filesystem": { "const": true },
    "writable_disk_size_bytes": { "const": 1073741824 },
    "writable_state_reuse": { "const": false },
    "network_devices": { "type": "array", "maxItems": 0 },
    "shares": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["purpose", "lease_id", "source_reference_kind", "guest_path", "access"],
        "properties": {
          "purpose": { "const": "LEASED_WORKTREE" },
          "lease_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
          "source_reference_kind": { "const": "OPAQUE_LEASE_ID" },
          "guest_path": { "const": "/workspace" },
          "access": { "const": "READ_WRITE" }
        }
      }
    },
    "guest_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uid", "gid", "working_directory", "interactive_shell", "login_enabled", "environment"],
      "properties": {
        "uid": { "const": 1000 },
        "gid": { "const": 1000 },
        "working_directory": { "const": "/workspace" },
        "interactive_shell": { "const": false },
        "login_enabled": { "const": false },
        "environment": { "type": "object", "maxProperties": 0 }
      }
    },
    "integrations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audio", "clipboard", "graphics", "keyboard", "pointing", "usb"],
      "properties": {
        "audio": { "const": false },
        "clipboard": { "const": false },
        "graphics": { "const": false },
        "keyboard": { "const": false },
        "pointing": { "const": false },
        "usb": { "const": false }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fresh_vm", "destructive_stop_required", "cleanup_verification_required"],
      "properties": {
        "fresh_vm": { "const": true },
        "destructive_stop_required": { "const": true },
        "cleanup_verification_required": { "const": true }
      }
    }
  }
}

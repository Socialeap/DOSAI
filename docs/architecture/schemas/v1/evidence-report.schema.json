{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:evidence-report:1",
  "title": "DOSAI Evidence Report v1",
  "type": "object",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": { "result": { "const": "PASS" } },
        "required": ["result"]
      },
      "then": {
        "properties": {
          "scenarios": {
            "not": {
              "contains": {
                "properties": { "result": { "enum": ["FAIL", "BLOCKED", "SKIPPED", "ERROR"] } },
                "required": ["result"]
              }
            }
          },
          "assertions": {
            "not": {
              "contains": {
                "properties": { "result": { "const": "FAIL" } },
                "required": ["result"]
              }
            }
          },
          "artifacts": {
            "not": {
              "contains": {
                "properties": { "availability": { "const": "SOURCE_UNAVAILABLE" } },
                "required": ["availability"]
              }
            }
          },
          "cleanup": { "properties": { "result": { "const": "PASS" } } },
          "external_effects": {
            "oneOf": [
              {
                "properties": {
                  "expected": { "const": "NONE" },
                  "observed": { "const": "NONE" },
                  "reconciled": { "const": true }
                }
              },
              {
                "properties": {
                  "expected": { "enum": ["LOCAL_MANAGED", "REMOTE_TEST"] },
                  "observed": { "const": "COMMITTED" },
                  "reconciled": { "const": true }
                }
              }
            ]
          },
          "secret_scan": { "properties": { "result": { "const": "PASS" } } },
          "gaps": { "maxItems": 0 },
          "exit_code": { "const": 0 }
        }
      }
    }
  ],
  "required": [
    "schema_id",
    "schema_version",
    "message_id",
    "created_at",
    "producer",
    "producer_generation",
    "trace_id",
    "data_class",
    "report_id",
    "catalog_digest",
    "catalog_version",
    "fixture_manifest_digest",
    "suite_id",
    "phase",
    "run_id",
    "attempt",
    "result",
    "started_at",
    "finished_at",
    "duration_ms",
    "environment",
    "subject",
    "runner",
    "command",
    "scenarios",
    "assertions",
    "artifacts",
    "cleanup",
    "external_effects",
    "secret_scan",
    "limitations",
    "gaps",
    "exit_code"
  ],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:evidence-report:1" },
    "schema_version": { "const": 1 },
    "message_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "producer": { "$ref": "urn:dosai:schema:common:1#/$defs/producer_id" },
    "producer_generation": { "$ref": "urn:dosai:schema:common:1#/$defs/decimal_sequence" },
    "trace_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "data_class": { "const": "D2" },
    "report_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "catalog_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
    "catalog_version": { "const": 1 },
    "fixture_manifest_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
    "suite_id": { "type": "string", "pattern": "^P(?:[0-9]|1[01])-AT-[0-9]{3}$" },
    "phase": { "type": "string", "enum": ["P0", "P1", "P2", "P3", "P4", "P5", "P6", "P7", "P8", "P9", "P10", "P11"] },
    "run_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "attempt": { "type": "integer", "minimum": 1, "maximum": 1000 },
    "result": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED", "ERROR"] },
    "started_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "finished_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "duration_ms": { "type": "integer", "minimum": 0, "maximum": 86400000 },
    "environment": { "$ref": "#/$defs/environment" },
    "subject": { "$ref": "#/$defs/subject" },
    "runner": { "$ref": "#/$defs/runner" },
    "command": { "$ref": "#/$defs/command" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/scenario_result" }
    },
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/assertion" }
    },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "#/$defs/artifact" }
    },
    "cleanup": { "$ref": "#/$defs/cleanup" },
    "external_effects": { "$ref": "#/$defs/external_effects" },
    "secret_scan": { "$ref": "#/$defs/secret_scan" },
    "limitations": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safe_code" }
    },
    "gaps": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/safe_code" }
    },
    "exit_code": { "type": "integer", "minimum": 0, "maximum": 255 }
  },
  "$defs": {
    "safe_code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$" },
    "safe_version": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform_profile", "macos_version", "macos_build", "hardware_model", "architecture", "components"],
      "properties": {
        "platform_profile": { "const": "MACOS_ARM64_V1" },
        "macos_version": { "$ref": "#/$defs/safe_version" },
        "macos_build": { "$ref": "#/$defs/safe_version" },
        "hardware_model": { "type": "string", "pattern": "^[A-Za-z0-9,._-]{1,64}$" },
        "architecture": { "const": "arm64" },
        "components": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "app": { "$ref": "#/$defs/safe_version" },
            "electron": { "$ref": "#/$defs/safe_version" },
            "chromium": { "$ref": "#/$defs/safe_version" },
            "node": { "$ref": "#/$defs/safe_version" },
            "v8": { "$ref": "#/$defs/safe_version" },
            "sqlite": { "$ref": "#/$defs/safe_version" },
            "git": { "$ref": "#/$defs/safe_version" }
          }
        }
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_id", "head_commit", "worktree_dirty", "schema_registry", "policy_version"],
      "properties": {
        "repository_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
        "head_commit": { "type": "string", "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$" },
        "worktree_dirty": { "type": "boolean" },
        "package_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "dependency_lock_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "schema_registry": { "const": "urn:dosai:schema-registry:2" },
        "policy_version": { "type": "integer", "minimum": 1 }
      }
    },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "executable_digest", "validator_id", "validator_version"],
      "properties": {
        "id": { "const": "dosai-acceptance" },
        "version": { "$ref": "#/$defs/safe_version" },
        "executable_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "validator_id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
        "validator_version": { "$ref": "#/$defs/safe_version" }
      }
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["executable", "args", "shell", "working_directory_class"],
      "properties": {
        "executable": { "const": "pnpm" },
        "args": {
          "type": "array",
          "prefixItems": [
            { "const": "exec" },
            { "const": "dosai-acceptance" },
            { "const": "run" },
            { "const": "--catalog" },
            { "const": "docs/testing/acceptance-test-catalog-v1.json" },
            { "const": "--suite" },
            { "type": "string", "pattern": "^P(?:[0-9]|1[01])-AT-[0-9]{3}$" },
            { "const": "--report-dir-env" },
            { "const": "DOSAI_EVIDENCE_DIR" }
          ],
          "items": false,
          "minItems": 9,
          "maxItems": 9
        },
        "shell": { "const": false },
        "working_directory_class": { "const": "LEASED_REPOSITORY_ROOT" }
      }
    },
    "scenario_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "assertion_ids"],
      "properties": {
        "id": { "type": "string", "pattern": "^P(?:[0-9]|1[01])-AT-[0-9]{3}-S[0-9]{2}$" },
        "result": { "type": "string", "enum": ["PASS", "FAIL", "BLOCKED", "SKIPPED", "ERROR"] },
        "assertion_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/safe_code" }
        },
        "error_code": { "type": "string", "pattern": "^DOSAI_[A-Z][A-Z0-9_]*_[0-9]{4}$" }
      }
    },
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "result", "expected_code", "observed_code", "artifact_ids"],
      "properties": {
        "id": { "$ref": "#/$defs/safe_code" },
        "result": { "type": "string", "enum": ["PASS", "FAIL"] },
        "expected_code": { "$ref": "#/$defs/safe_code" },
        "observed_code": { "$ref": "#/$defs/safe_code" },
        "artifact_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" }
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_id", "artifact_class", "manifest_digest", "media_type", "data_class", "retention_profile", "availability", "byte_length"],
      "properties": {
        "artifact_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
        "artifact_class": { "type": "string", "enum": ["REPORT", "ASSERTIONS", "ENVIRONMENT", "COMMAND", "MANIFEST", "JOURNAL", "CANARY", "PACKAGE", "SCREENSHOT", "PERFORMANCE", "CLEANUP", "VERIFIER"] },
        "manifest_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "media_type": { "type": "string", "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$", "maxLength": 96 },
        "data_class": { "type": "string", "enum": ["D2", "D3", "D5"] },
        "retention_profile": { "type": "string", "enum": ["R2_EVIDENCE_SHORT", "R3_EVIDENCE_STANDARD", "R6_VERSIONED_CONFIG"] },
        "availability": { "type": "string", "enum": ["AVAILABLE", "SOURCE_UNAVAILABLE"] },
        "byte_length": { "type": "integer", "minimum": 0, "maximum": 1073741824 }
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "assertion_ids"],
      "properties": {
        "result": { "type": "string", "enum": ["PASS", "FAIL", "UNKNOWN"] },
        "assertion_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safe_code" } }
      }
    },
    "external_effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed", "reconciled"],
      "properties": {
        "expected": { "type": "string", "enum": ["NONE", "LOCAL_MANAGED", "REMOTE_TEST"] },
        "observed": { "type": "string", "enum": ["NONE", "COMMITTED", "PARTIAL", "UNKNOWN"] },
        "reconciled": { "type": "boolean" }
      }
    },
    "secret_scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "canary_set_version"],
      "properties": {
        "result": { "type": "string", "enum": ["PASS", "FAIL", "NOT_RUN"] },
        "canary_set_version": { "type": "integer", "minimum": 1 }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:dosai:schema:acceptance-catalog-implementation:1",
  "title": "DOSAI Acceptance Catalog Implementation Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_id", "schema_version", "manifest_id", "created_at", "data_class", "status", "predecessor", "successor", "runner", "schemas", "implementations", "invariants"],
  "properties": {
    "schema_id": { "const": "urn:dosai:schema:acceptance-catalog-implementation:1" },
    "schema_version": { "const": 1 },
    "manifest_id": { "$ref": "urn:dosai:schema:common:1#/$defs/uuid_v4" },
    "created_at": { "$ref": "urn:dosai:schema:common:1#/$defs/utc_timestamp" },
    "data_class": { "const": "D5" },
    "status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED", "SUPERSEDED"] },
    "predecessor": { "$ref": "#/$defs/catalog_reference" },
    "successor": { "$ref": "#/$defs/catalog_reference" },
    "runner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "package_path", "package_digest", "executable_digest", "dependency_lock_digest", "workspace_config_digest", "workspace_specifier", "shell"],
      "properties": {
        "id": { "const": "dosai-acceptance" },
        "version": { "const": "0.1.0" },
        "package_path": { "const": "tools/dosai-acceptance/package.json" },
        "package_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "executable_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "dependency_lock_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "workspace_config_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" },
        "workspace_specifier": { "const": "workspace:0.1.0" },
        "shell": { "const": false }
      }
    },
    "schemas": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "$ref": "#/$defs/schema_reference" }
    },
    "implementations": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "$ref": "#/$defs/implementation" }
    },
    "invariants": {
      "const": ["ONLY_P1_SUITES_IMPLEMENTED", "SCENARIO_SCOPE_UNCHANGED", "FIXTURES_DIGEST_BOUND", "FAIL_CLOSED_RUNNER", "REPORT_IS_IMPLICIT_REQUIRED_ARTIFACT", "NO_EXTERNAL_EFFECT"]
    }
  },
  "$defs": {
    "catalog_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "version", "sha256"],
      "properties": {
        "path": { "type": "string", "pattern": "^docs/testing/acceptance-test-catalog-v[23]\\.json$" },
        "version": { "type": "integer", "minimum": 2, "maximum": 3 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "schema_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_id", "path", "sha256"],
      "properties": {
        "schema_id": { "type": "string", "pattern": "^urn:dosai:schema:[a-z-]+:[13]$" },
        "path": { "type": "string", "pattern": "^docs/architecture/schemas/v[13]/[a-z-]+\\.schema\\.json$" },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "implementation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["suite_id", "previous_state", "current_state", "fixture_manifest", "fixture_status", "fixture_digest"],
      "properties": {
        "suite_id": { "type": "string", "pattern": "^P1-AT-00[1-3]$" },
        "previous_state": { "const": "NOT_IMPLEMENTED" },
        "current_state": { "const": "IMPLEMENTED" },
        "fixture_manifest": { "type": "string", "pattern": "^tests/acceptance/manifests/p1-at-00[1-3]\\.json$" },
        "fixture_status": { "type": "string", "enum": ["PROPOSED", "ACCEPTED"] },
        "fixture_digest": { "$ref": "urn:dosai:schema:common:1#/$defs/digest" }
      }
    }
  }
}

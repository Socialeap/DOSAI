      "may_hold_authority": false,
      "allowed_first_party_imports": ["contracts", "workers"],
      "allowed_external_imports": []
    }
  ],
  "native_helper_root": "native-helpers",
  "reserved_native_helpers": [
    {
      "id": "policy-helper",
      "path": "native-helpers/policy",
      "trust_zone": "Z4",
      "component_owner": "policy-kernel",

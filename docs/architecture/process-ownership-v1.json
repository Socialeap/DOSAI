      "path": "src/renderer",
      "trust_zone": "Z1",
      "runtime": "CHROMIUM_SANDBOX",
      "component_owner": "presentation",
      "implementation_state": "ACTIVE",
      "may_hold_authority": false,
      "allowed_first_party_imports": ["contracts", "renderer"],
      "allowed_external_imports": ["react", "react-dom/client"]
    },
    {
      "id": "preload",
      "path": "src/preload",
      "trust_zone": "Z2",
      "runtime": "ELECTRON_SANDBOXED_PRELOAD",

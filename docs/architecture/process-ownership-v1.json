      "implementation_state": "ACTIVE",
      "may_hold_authority": false,
      "allowed_first_party_imports": ["contracts", "preload"],
      "allowed_external_imports": ["electron"]
    },
    {
      "id": "main",
      "path": "src/main",
      "trust_zone": "Z3",
      "runtime": "ELECTRON_MAIN",
      "component_owner": "application-coordinator",
      "implementation_state": "ACTIVE",
      "may_hold_authority": false,
      "allowed_first_party_imports": ["contracts", "main"],
      "allowed_external_imports": ["electron", "node:fs/promises", "node:path"]

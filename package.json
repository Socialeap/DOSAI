{
  "name": "dosai",
  "productName": "DOSAI",
  "version": "0.1.0",
  "description": "Dashboard for Optimizing Seamless Agent Interaction",
  "private": true,
  "type": "module",
  "main": "dist/main/index.cjs",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "audit:p1": "node tests/runtime/p1-packaged-runtime-audit.mjs",
    "build": "node scripts/build.mjs",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build",
    "dev": "node scripts/dev.mjs",
    "package": "node scripts/package.mjs",
    "test": "node --test tests/*/*.test.mjs",
    "typecheck": "pnpm run typecheck:tooling && pnpm run typecheck:audit && pnpm run typecheck:main && pnpm run typecheck:policy && pnpm run typecheck:preload && pnpm run typecheck:renderer && pnpm run typecheck:workers",
    "typecheck:audit": "tsc -p tsconfig.audit.json --noEmit",
    "typecheck:main": "tsc -p tsconfig.main.json --noEmit",
    "typecheck:policy": "tsc -p tsconfig.policy.json --noEmit",
    "typecheck:preload": "tsc -p tsconfig.preload.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:tooling": "tsc -p tsconfig.tooling.json --noEmit",
    "typecheck:workers": "tsc -p tsconfig.workers.json --noEmit"
  },
  "devDependencies": {
    "@babel/parser": "7.28.5",
    "@electron/asar": "4.2.1",
    "@electron/fuses": "2.1.3",
    "@electron/packager": "20.0.4",
    "@types/node": "24.13.3",
    "@types/plist": "3.0.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "dosai-acceptance": "workspace:0.1.1",
    "electron": "43.2.0",
    "plist": "3.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "7.0.2",
    "vite": "8.2.0"
  }
}
